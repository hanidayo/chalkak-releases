<local:ChromeWindow x:Class="Chalkak.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Chalkak"
        Title="편집" Width="1240" Height="860" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen" ShowZoom="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 도구 모음 ===== -->
        <Border Grid.Row="0" Background="{DynamicResource TitleBg}" BorderBrush="{DynamicResource Separator}"
                BorderThickness="0,0,0,1" Padding="16,10,16,10">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <StackPanel x:Name="ToolPanel" Orientation="Horizontal" DockPanel.Dock="Left">
                        <RadioButton x:Name="Tool_Select" GroupName="tools" Tag="Select" ToolTip="선택 · 이동 · 크기 조절 (V)" Style="{StaticResource ToolButton}" Padding="9,7" IsChecked="True" Checked="Tool_Checked">
                            <Path Style="{StaticResource Ico}" Data="M5,3 L5,19 L9.2,15.2 L12,21 L14.6,19.8 L11.8,14.2 L17.5,14 Z"/>
                        </RadioButton>
                        <RadioButton x:Name="Tool_Crop" GroupName="tools" Tag="Crop" ToolTip="자르기 (C)" Style="{StaticResource ToolButton}" Padding="9,7" Checked="Tool_Checked">
                            <Path Style="{StaticResource Ico}" Data="M7,2 V17 H22 M2,7 H17 V22"/>
                        </RadioButton>
                        <RadioButton x:Name="Tool_Marquee" GroupName="tools" Tag="Marquee" ToolTip="복사할 영역 선택 (S)" Style="{StaticResource ToolButton}" Padding="9,7" Checked="Tool_Checked">
                            <Path Style="{StaticResource Ico}" Data="M4,4 H20 V20 H4 Z" StrokeDashArray="2.2,2.2"/>
                        </RadioButton>
                        <Border Width="1" Height="20" Background="{DynamicResource Separator}" Margin="8,0"/>
                        <RadioButton x:Name="Tool_Pen" GroupName="tools" Tag="Pen" ToolTip="연필 (P)" Style="{StaticResource ToolButton}" Padding="9,7" Checked="Tool_Checked">
                            <Path Style="{StaticResource Ico}" Data="M4,20 L5,15 L16,4 L20,8 L9,19 Z M13.5,6.5 L17.5,10.5"/>
                        </RadioButton>
                        <RadioButton x:Name="Tool_Line" GroupName="tools" Tag="Line" ToolTip="직선 (L) · Shift: 15° 단위" Style="{StaticResource ToolButton}" Padding="9,7" Checked="Tool_Checked">
                            <Path Style="{StaticResource Ico}" Data="M5,19 L19,5"/>
                        </RadioButton>
                        <RadioButton x:Name="Tool_Arrow" GroupName="tools" Tag="Arrow" ToolTip="화살표 (A)" Style="{StaticResource ToolButton}" Padding="9,7" Checked="Tool_Checked">
                            <Path Style="{StaticResource Ico}" Data="M5,19 L19,5 M9,5 H19 V15"/>
                        </RadioButton>
                        <RadioButton x:Name="Tool_Ellipse" GroupName="tools" Tag="Ellipse" ToolTip="원 · 타원 (O) · Shift: 정원" Style="{StaticResource ToolButton}" Padding="9,7" Checked="Tool_Checked">
                            <Path Style="{StaticResource Ico}" Data="M3,12 A9,7 0 1 0 21,12 A9,7 0 1 0 3,12 Z"/>
                        </RadioButton>
                        <RadioButton x:Name="Tool_Rect" GroupName="tools" Tag="Rect" ToolTip="사각형 (R) · Shift: 정사각형" Style="{StaticResource ToolButton}" Padding="9,7" Checked="Tool_Checked">
                            <Path Style="{StaticResource Ico}" Data="M7,5 H17 A2,2 0 0 1 19,7 V17 A2,2 0 0 1 17,19 H7 A2,2 0 0 1 5,17 V7 A2,2 0 0 1 7,5 Z"/>
                        </RadioButton>
                        <RadioButton x:Name="Tool_Text" GroupName="tools" Tag="Text" ToolTip="텍스트 (T)" Style="{StaticResource ToolButton}" Padding="9,7" Checked="Tool_Checked">
                            <Path Style="{StaticResource Ico}" Data="M5,7 V4.5 H19 V7 M12,4.5 V20 M9,20 H15"/>
                        </RadioButton>
                        <Border Width="1" Height="20" Background="{DynamicResource Separator}" Margin="8,0"/>
                        <RadioButton x:Name="Tool_Mosaic" GroupName="tools" Tag="Mosaic" ToolTip="모자이크 (M)" Style="{StaticResource ToolButton}" Padding="9,7" Checked="Tool_Checked">
                            <Path Style="{StaticResource Ico}" Data="M4,4 H9 V9 H4 Z M14,4 H19 V9 H14 Z M9,9 H14 V14 H9 Z M4,14 H9 V19 H4 Z M14,14 H19 V19 H14 Z"/>
                        </RadioButton>
                        <RadioButton x:Name="Tool_Blur" GroupName="tools" Tag="Blur" ToolTip="블러 (B)" Style="{StaticResource ToolButton}" Padding="9,7" Checked="Tool_Checked">
                            <Path Style="{StaticResource Ico}" Data="M12,3 C12,3 5,10.5 5,15 A7,7 0 0 0 19,15 C19,10.5 12,3 12,3 Z"/>
                        </RadioButton>
                        <RadioButton x:Name="Tool_Eraser" GroupName="tools" Tag="Eraser" ToolTip="편집 객체 지우기 (E)" Style="{StaticResource ToolButton}" Padding="9,7" Checked="Tool_Checked">
                            <Path Style="{StaticResource Ico}" Data="M3.5,15.5 L13,5 L20,12 L13.5,19.5 H8 Z M8.5,10 L16,17.5"/>
                        </RadioButton>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button x:Name="CopyBtn" Content="복사" ToolTip="영역이 있으면 영역만, 없으면 전체 (Ctrl+C)" Style="{StaticResource PillButton}" Padding="14,6" Margin="0,0,6,0" Click="Copy_Click"/>
                        <Button x:Name="FolderBtn" Content="폴더 열기" Style="{StaticResource PillButton}" Padding="14,6" Margin="0,0,6,0" Click="Folder_Click"/>
                        <Button x:Name="ShareBtn" Content="공유" Style="{StaticResource PillButton}" Padding="14,6" Margin="0,0,6,0" Click="Share_Click"/>
                        <Button x:Name="SaveBtn" Content="편집본 저장" ToolTip="원본은 그대로 두고 _edited 파일로 저장 (Ctrl+S)" Style="{StaticResource PrimaryButton}" Padding="16,6" Click="Save_Click"/>
                    </StackPanel>
                </DockPanel>

                <DockPanel LastChildFill="False" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Button x:Name="UndoBtn" ToolTip="실행 취소 (Ctrl+Z)" Style="{StaticResource PillButton}" Padding="9,6" Margin="0,0,6,0" Click="Undo_Click">
                            <Path Style="{StaticResource Ico}" Data="M9,6 L4,11 L9,16 M4,11 H14 A5,5 0 0 1 14,21 H10"/>
                        </Button>
                        <Button x:Name="RedoBtn" ToolTip="다시 실행 (Ctrl+Y)" Style="{StaticResource PillButton}" Padding="9,6" Click="Redo_Click">
                            <Path Style="{StaticResource Ico}" Data="M15,6 L20,11 L15,16 M20,11 H10 A5,5 0 0 0 10,21 H14"/>
                        </Button>
                        <Border Width="1" Height="20" Background="{DynamicResource Separator}" Margin="14,0"/>
                        <StackPanel x:Name="ColorPanel" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton GroupName="colors" Background="#FF3B30" Tag="#FF3B30" Style="{StaticResource SwatchRadio}" IsChecked="True" Checked="Color_Checked"/>
                            <RadioButton GroupName="colors" Background="#FF9500" Tag="#FF9500" Style="{StaticResource SwatchRadio}" Checked="Color_Checked"/>
                            <RadioButton GroupName="colors" Background="#FFCC00" Tag="#FFCC00" Style="{StaticResource SwatchRadio}" Checked="Color_Checked"/>
                            <RadioButton GroupName="colors" Background="#34C759" Tag="#34C759" Style="{StaticResource SwatchRadio}" Checked="Color_Checked"/>
                            <RadioButton GroupName="colors" Background="#007AFF" Tag="#007AFF" Style="{StaticResource SwatchRadio}" Checked="Color_Checked"/>
                            <RadioButton GroupName="colors" Background="#AF52DE" Tag="#AF52DE" Style="{StaticResource SwatchRadio}" Checked="Color_Checked"/>
                            <RadioButton GroupName="colors" Background="#1D1D1F" Tag="#1D1D1F" Style="{StaticResource SwatchRadio}" Checked="Color_Checked"/>
                            <RadioButton GroupName="colors" Background="#FFFFFF" Tag="#FFFFFF" Style="{StaticResource SwatchRadio}" Checked="Color_Checked"/>
                            <Button Content="＋" ToolTip="색 직접 고르기" Style="{StaticResource PillButton}" Padding="8,2" Margin="6,0,0,0" Click="CustomColor_Click"/>
                        </StackPanel>
                        <Border Width="1" Height="20" Background="{DynamicResource Separator}" Margin="14,0"/>
                        <TextBlock x:Name="WidthLabel" Text="굵기" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider x:Name="WidthSlider" Style="{StaticResource AppleSlider}" Minimum="1" Maximum="24" Value="4" Width="130"
                                VerticalAlignment="Center" ValueChanged="Width_Changed"
                                PreviewMouseLeftButtonDown="Slider_Down" PreviewMouseLeftButtonUp="Slider_Up"/>
                        <TextBlock x:Name="WidthValue" Text="4" Width="26" TextAlignment="Right" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <Border Width="1" Height="20" Background="{DynamicResource Separator}" Margin="14,0"/>
                        <TextBlock Text="채우기" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ToggleButton x:Name="FillSwitch" Style="{StaticResource AppleSwitch}" Click="Fill_Click"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- ===== 편집 영역 ===== -->
        <Grid Grid.Row="1" Background="{DynamicResource Canvas}">
            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="Scroller_Wheel" PreviewMouseDown="Scroller_MouseDown"
                          PreviewMouseUp="Scroller_MouseUp" PreviewMouseMove="Scroller_MouseMove">
                <Grid x:Name="Stage" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid x:Name="Host">
                        <Canvas x:Name="Overlay"/>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <Border x:Name="CropBar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,26"
                    Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource Separator}" BorderThickness="1"
                    CornerRadius="14" Padding="10" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="CropText" VerticalAlignment="Center" Margin="8,0,16,0" Foreground="{DynamicResource TextSecondary}"/>
                    <Button Content="취소  (Esc)" Style="{StaticResource PillButton}" Padding="14,6" Margin="0,0,8,0" Click="CropCancel_Click"/>
                    <Button Content="자르기 적용  (Enter)" Style="{StaticResource PrimaryButton}" Padding="16,6" Click="CropApply_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 상태 표시줄 ===== -->
        <Border Grid.Row="2" Background="{DynamicResource TitleBg}" BorderBrush="{DynamicResource Separator}"
                BorderThickness="0,1,0,0" Padding="16,7">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="InfoText" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="−" Style="{StaticResource PillButton}" Padding="12,2" Click="ZoomOut_Click"/>
                    <TextBlock x:Name="ZoomText" Width="56" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                    <Button Content="＋" Style="{StaticResource PillButton}" Padding="12,2" Click="ZoomIn_Click"/>
                    <Button Content="화면 맞춤" ToolTip="Ctrl+0" Style="{StaticResource PillButton}" Padding="12,3" Margin="10,0,6,0" Click="Fit_Click"/>
                    <Button Content="100%" ToolTip="Ctrl+1" Style="{StaticResource PillButton}" Padding="12,3" Click="Actual_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</local:ChromeWindow>
