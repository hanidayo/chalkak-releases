<local:ChromeWindow x:Class="Chalkak.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Chalkak"
        Title="찰칵 설정" Width="620" Height="640" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterScreen" ShowMinimize="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border x:Name="TabHost" Grid.Row="0" Margin="30,16,30,4" HorizontalAlignment="Left"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Root" Margin="30,0,30,30"/>
        </ScrollViewer>
    </Grid>
</local:ChromeWindow>
